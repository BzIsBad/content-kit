{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(\"{{NODE}}\" \"{{KIT}}\" *)",
      "Bash(\"{{NODE}}\" --version)",
      "PowerShell(& \"{{NODE}}\" \"{{KIT}}\" *)",
      "PowerShell(& \"{{NODE}}\" --version)",
      "Edit(/brands/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/CLAUDE.md)",
      "Read(~/.content-kit/**)",
      "Read(~/.claude/plugins/**)"
    ],
    "deny": [
      "Edit(/brands/*/raw/**)"
    ]
  }
}
